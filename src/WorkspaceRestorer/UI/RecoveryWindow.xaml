<Window x:Class="WorkspaceRestorer.UI.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore Workspace"
        Width="520" Height="480"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        KeyDown="OnKeyDown">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="&#x1F504;" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitleText" Text="Unclean shutdown detected" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Text="Select applications to restore"
                           Foreground="#666" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Select all / none -->
        <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="False">
            <CheckBox x:Name="SelectAllBox" Content="Select all" Checked="SelectAll_Changed" Unchecked="SelectAll_Changed" />
            <TextBlock x:Name="CountText" Foreground="#666" VerticalAlignment="Center" Margin="12,0,0,0" />
        </DockPanel>

        <!-- App list -->
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                <ItemsControl x:Name="AppList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0" />
                                    <Image Grid.Column="1"
                                           Source="{Binding Icon}"
                                           Width="20" Height="20"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DetailText}" Foreground="#777" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}"
                                               Foreground="#999" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#444" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="DiscardButton" Content="Discard" Width="100" Margin="0,0,8,0" Click="Discard_Click" IsCancel="True" />
            <Button x:Name="RestoreButton" Content="Restore Selected" Width="140" FontWeight="SemiBold" Click="Restore_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
